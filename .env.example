# The API defaults to memory storage. Set postgres only after starting a local
# PostgreSQL instance (native or via the optional compose file).
QERVON_STORAGE=memory
QERVON_LISTEN=127.0.0.1:8080
RUST_LOG=qervon_api_gateway=info,tower_http=info

# Local-filesystem root for uploaded files (delivery-proof photos). Must be
# a persistent, backed-up path in production — defaults to ./data/uploads.
# QERVON_UPLOADS_DIR=/var/lib/qervon/uploads

# Required for every API runtime, including local memory storage.
# DATABASE_URL=postgres://qervon_user:replace-me@127.0.0.1:5432/qervon_db
# QERVON_API_ACCESS_TOKEN=generate-a-long-random-production-token
QERVON_TOKEN_SIGNING_SECRET=replace-with-a-32-plus-character-local-secret

# PostgreSQL connection pool size (postgres storage mode only). Default is
# 20. Raise this for larger courier fleets — every location ping issues a
# couple of small writes, and a fleet of a few thousand couriers reporting
# every few seconds sustains well over a thousand requests/second; a pool
# too small becomes an artificial queueing point ahead of Postgres' own
# limits. Tune alongside your Postgres instance's own `max_connections`.
# QERVON_POSTGRES_MAX_CONNECTIONS=20

# Required by the outbox worker. Generate 32 random bytes and base64 encode them.
# QERVON_WEBHOOK_ENCRYPTION_KEY=base64-encoded-32-byte-key
# QERVON_WORKER_BATCH_SIZE=50
# QERVON_WEBHOOK_MAX_ATTEMPTS=8
# QERVON_WORKER_POLL_SECONDS=5
# QERVON_WORKER_RUN_ONCE=false
# QERVON_OUTBOUND_TIMEOUT_SECONDS=10
# Comma-separated approved webhook DNS suffixes. With no entries, the worker
# never makes an outbound webhook request.
# QERVON_WEBHOOK_ALLOWED_HOSTS=hooks.example.com,partner.example
# Browser push requires VAPID material. The private key stays worker-only;
# the matching public key is safe to expose to signed browser sessions.
# QERVON_WEB_PUSH_VAPID_PUBLIC_KEY=base64url-public-key
# QERVON_WEB_PUSH_VAPID_PRIVATE_KEY=base64url-private-key
# QERVON_WEB_PUSH_VAPID_SUBJECT=mailto:operations@example.com

# Required only by the optional Docker development services.
# QERVON_POSTGRES_PASSWORD=replace-me-with-a-local-development-password
