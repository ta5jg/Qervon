# ==============================================================================

# macOS
.DS_Store

# Environment files (keep examples only)
.env
.env.*
!.env.example

# Rust / Cargo build artifacts
target/
**/target/

# Node / Web build artifacts
node_modules/
dist/
*.tsbuildinfo

# Android / Gradle build artifacts
.gradle/
.kotlin/
build/
*.apk
*.aab
local.properties

# iOS / Xcode user state
DerivedData/
xcuserdata/
*.xcuserstate
*.xcresult

# iOS: XcodeGen-generated project (Project.yml is the source of truth --
# regenerate with `xcodegen generate`, see mobile/ios/README.md)
mobile/ios/*.xcodeproj/
mobile/ios/*.xcworkspace/

# Swift Package Manager local build/resolution caches
.swiftpm/
.build/
mobile/ios/.build-artifacts/

# Local machine-specific agent settings
.claude/settings.local.json

# Accidental Finder duplicates
.github copy/
