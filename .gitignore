# macOS
.DS_Store

# Environment files (keep examples only)
.env
.env.*
!.env.example

# Rust / Cargo build artifacts
target/
**/target/

# Node / Web build artifacts
node_modules/
dist/
*.tsbuildinfo

# Android / Gradle build artifacts
.gradle/
build/
*.apk
*.aab
local.properties

# iOS / Xcode user state
DerivedData/
xcuserdata/
*.xcuserstate

# Local machine-specific agent settings
.claude/settings.local.json

# Accidental Finder duplicates
.github copy/
